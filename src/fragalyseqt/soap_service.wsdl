<?xml version="1.0" encoding="UTF-8"?>
<definitions name="FragalyseQtService"
    targetNamespace="http://fragalyseqt.dorif.dev/soap/v1"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:tns="http://fragalyseqt.dorif.dev/soap/v1"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- ============================================================ -->
  <!--  Types                                                        -->
  <!-- ============================================================ -->
  <types>
    <xsd:schema targetNamespace="http://fragalyseqt.dorif.dev/soap/v1"
                elementFormDefault="qualified">

      <xsd:complexType name="SessionInfo">
        <xsd:sequence>
          <xsd:element name="session_id"  type="xsd:int"/>
          <xsd:element name="file_name"   type="xsd:string"/>
          <xsd:element name="instrument"  type="xsd:string"/>
          <xsd:element name="dye_count"   type="xsd:int"/>
          <xsd:element name="has_sizing"  type="xsd:boolean"/>
          <xsd:element name="has_panel"   type="xsd:boolean"/>
          <xsd:element name="panel_name"  type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="PeakRecord">
        <xsd:sequence>
          <xsd:element name="channel"     type="xsd:int"/>
          <xsd:element name="dye_name"    type="xsd:string"/>
          <xsd:element name="position_dp" type="xsd:double"/>
          <xsd:element name="size_bp"     type="xsd:double"/>
          <xsd:element name="height"      type="xsd:double"/>
          <xsd:element name="fwhm"        type="xsd:double"/>
          <xsd:element name="area"        type="xsd:double"/>
          <xsd:element name="allele"      type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="AnalysisParams">
        <xsd:sequence>
          <xsd:element name="min_height"           type="xsd:int"/>
          <xsd:element name="min_width"            type="xsd:int"/>
          <xsd:element name="min_prominence"       type="xsd:int"/>
          <xsd:element name="halfwindow_width"         type="xsd:int"/>
          <xsd:element name="peak_window"          type="xsd:int"/>
          <xsd:element name="baseline_correction"  type="xsd:boolean"/>
          <xsd:element name="size_standard"        type="xsd:string"/>
          <xsd:element name="sizing_method"        type="xsd:string"/>
          <xsd:element name="panel"                type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="StoredSession">
        <xsd:sequence>
          <xsd:element name="session_id"  type="xsd:int"/>
          <xsd:element name="name"        type="xsd:string"/>
          <xsd:element name="created_at"  type="xsd:string"/>
          <xsd:element name="created_by"  type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- Reference profile types -->
      <xsd:complexType name="RefProfileInfo">
        <xsd:sequence>
          <xsd:element name="id"     type="xsd:int"/>
          <xsd:element name="name"   type="xsd:string"/>
          <xsd:element name="role"   type="xsd:string"/>
          <xsd:element name="n_loci" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="AlleleCall">
        <xsd:sequence>
          <xsd:element name="marker"  type="xsd:string"/>
          <xsd:element name="allele1" type="xsd:string"/>
          <xsd:element name="allele2" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="RefProfileDetail">
        <xsd:sequence>
          <xsd:element name="id"         type="xsd:int"/>
          <xsd:element name="name"       type="xsd:string"/>
          <xsd:element name="role"       type="xsd:string"/>
          <xsd:element name="notes"      type="xsd:string"/>
          <xsd:element name="created_at" type="xsd:string"/>
          <xsd:element name="allele_call" type="tns:AlleleCall"
                        minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="ProfileMatch">
        <xsd:sequence>
          <xsd:element name="profile_id" type="xsd:int"/>
          <xsd:element name="name"       type="xsd:string"/>
          <xsd:element name="role"       type="xsd:string"/>
          <xsd:element name="matched"    type="xsd:int"/>
          <xsd:element name="common"     type="xsd:int"/>
          <xsd:element name="status"     type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="LocusResult">
        <xsd:sequence>
          <xsd:element name="marker"     type="xsd:string"/>
          <xsd:element name="alleles_q"  type="xsd:string"/>
          <xsd:element name="alleles_r"  type="xsd:string"/>
          <xsd:element name="freq_a1"    type="xsd:double"/>
          <xsd:element name="freq_a2"    type="xsd:string"/>
          <xsd:element name="locus_stat" type="xsd:string"/>
          <xsd:element name="included"   type="xsd:boolean"/>
          <xsd:element name="note"       type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="ComparisonResult">
        <xsd:sequence>
          <xsd:element name="combined_stat" type="xsd:double"/>
          <xsd:element name="log10_stat"    type="xsd:double"/>
          <xsd:element name="verbal_scale"  type="xsd:string"/>
          <xsd:element name="n_loci"        type="xsd:int"/>
          <xsd:element name="n_excluded"    type="xsd:int"/>
          <xsd:element name="n_only_q"      type="xsd:int"/>
          <xsd:element name="n_only_r"      type="xsd:int"/>
          <xsd:element name="locus" type="tns:LocusResult"
                        minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- ── Existing request elements ── -->
      <xsd:element name="GetSessionList"/>
      <xsd:element name="GetPeakTable">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetAnalysisParams">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ExportCSV">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetRawSignal">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
          <xsd:element name="channel"    type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SubmitFile">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="file_name"   type="xsd:string"/>
          <xsd:element name="content_b64" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SetAnalysisParams">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
          <xsd:element name="params"     type="tns:AnalysisParams"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="TriggerReanalysis">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="TriggerBatchProcess">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="CloseSession">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SaveSession">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="name" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ListSessions"/>
      <xsd:element name="OpenSession">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="DeleteSession">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ListPanels"/>
      <xsd:element name="ImportPanel">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="panels_file_name"    type="xsd:string"/>
          <xsd:element name="panels_content_b64"  type="xsd:string"/>
          <xsd:element name="bins_file_name"      type="xsd:string" minOccurs="0"/>
          <xsd:element name="bins_content_b64"    type="xsd:string" minOccurs="0"/>
          <xsd:element name="stutter_file_name"   type="xsd:string" minOccurs="0"/>
          <xsd:element name="stutter_content_b64" type="xsd:string" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <!-- ── New request elements ── -->
      <xsd:element name="ImportFreqTable">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="file_name"   type="xsd:string"/>
          <xsd:element name="content_b64" type="xsd:string"/>
          <xsd:element name="table_name"  type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ListFreqTables"/>
      <xsd:element name="ListRefProfiles"/>

      <!-- database: required; must be "casework" or "refprofiles" -->
      <xsd:element name="ImportRefProfile">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="xml_b64"  type="xsd:string"/>
          <xsd:element name="database" type="xsd:string"/>
          <xsd:element name="role"     type="xsd:string" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <!-- Profile source: provide exactly one of session_id / profile_id_q.
           database: required; must be "casework" or "refprofiles" -->
      <xsd:element name="StoreRefProfile">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_q" type="xsd:int"    minOccurs="0"/>
          <xsd:element name="name"         type="xsd:string"/>
          <xsd:element name="database"     type="xsd:string"/>
          <xsd:element name="role"         type="xsd:string" minOccurs="0"/>
          <xsd:element name="notes"        type="xsd:string" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="SearchProfiles">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id"   type="xsd:int" minOccurs="0"/>
          <xsd:element name="profile_id_q" type="xsd:int" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="GetRefProfile">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="profile_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="UpdateRefProfile">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="profile_id" type="xsd:int"/>
          <xsd:element name="name"       type="xsd:string" minOccurs="0"/>
          <xsd:element name="role"       type="xsd:string" minOccurs="0"/>
          <xsd:element name="notes"      type="xsd:string" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="DeleteRefProfile">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="profile_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <!-- Profile source for comparison: provide one of session_id_q/profile_id_q
           and one of session_id_r/profile_id_r -->
      <xsd:element name="ExportIdentityPDF">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="session_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="table_name"     type="xsd:string"/>
          <xsd:element name="theta"          type="xsd:double" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ExportKinshipPDF">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="session_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="table_name"     type="xsd:string"/>
          <xsd:element name="relationship"   type="xsd:string"/>
          <xsd:element name="theta"          type="xsd:double" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ExportIdentityPDFResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="pdf_b64" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ExportKinshipPDFResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="pdf_b64" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="CompareIdentity">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="session_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="table_name"     type="xsd:string"/>
          <xsd:element name="theta"          type="xsd:double" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="CompareKinship">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_q"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="session_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="profile_id_r"   type="xsd:int"    minOccurs="0"/>
          <xsd:element name="table_name"     type="xsd:string"/>
          <xsd:element name="relationship"   type="xsd:string"/>
          <xsd:element name="theta"          type="xsd:double" minOccurs="0"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <!-- ── Existing response elements ── -->
      <xsd:element name="GetSessionListResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session" type="tns:SessionInfo"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetPeakTableResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="peak" type="tns:PeakRecord"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetAnalysisParamsResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="params" type="tns:AnalysisParams"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ExportCSVResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="csv_content" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetRawSignalResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="sample" type="xsd:double"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SubmitFileResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SetAnalysisParamsResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="TriggerReanalysisResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="TriggerBatchProcessResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="CloseSessionResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="SaveSessionResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ListSessionsResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="session" type="tns:StoredSession"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="OpenSessionResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="success"  type="xsd:boolean"/>
          <xsd:element name="readonly" type="xsd:boolean"/>
          <xsd:element name="tabs"     type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="DeleteSessionResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ListPanelsResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="panel_name" type="xsd:string"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ImportPanelResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="panel_name" type="xsd:string"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <!-- ── New response elements ── -->
      <xsd:element name="ImportFreqTableResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="table_name" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ListFreqTablesResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="table_name" type="xsd:string"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ListRefProfilesResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="profile" type="tns:RefProfileInfo"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ImportRefProfileResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="profile_id" type="xsd:int"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="StoreRefProfileResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="profile_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="SearchProfilesResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="match" type="tns:ProfileMatch"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="GetRefProfileResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="profile" type="tns:RefProfileDetail"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="UpdateRefProfileResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="new_profile_id" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="DeleteRefProfileResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="success" type="xsd:boolean"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="CompareIdentityResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="result" type="tns:ComparisonResult"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="CompareKinshipResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="result" type="tns:ComparisonResult"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <!-- ============================================================ -->
  <!--  Messages                                                     -->
  <!-- ============================================================ -->
  <message name="GetSessionListIn">
    <part name="parameters" element="tns:GetSessionList"/>
  </message>
  <message name="GetSessionListOut">
    <part name="parameters" element="tns:GetSessionListResponse"/>
  </message>
  <message name="GetPeakTableIn">
    <part name="parameters" element="tns:GetPeakTable"/>
  </message>
  <message name="GetPeakTableOut">
    <part name="parameters" element="tns:GetPeakTableResponse"/>
  </message>
  <message name="GetAnalysisParamsIn">
    <part name="parameters" element="tns:GetAnalysisParams"/>
  </message>
  <message name="GetAnalysisParamsOut">
    <part name="parameters" element="tns:GetAnalysisParamsResponse"/>
  </message>
  <message name="ExportCSVIn">
    <part name="parameters" element="tns:ExportCSV"/>
  </message>
  <message name="ExportCSVOut">
    <part name="parameters" element="tns:ExportCSVResponse"/>
  </message>
  <message name="GetRawSignalIn">
    <part name="parameters" element="tns:GetRawSignal"/>
  </message>
  <message name="GetRawSignalOut">
    <part name="parameters" element="tns:GetRawSignalResponse"/>
  </message>
  <message name="SubmitFileIn">
    <part name="parameters" element="tns:SubmitFile"/>
  </message>
  <message name="SubmitFileOut">
    <part name="parameters" element="tns:SubmitFileResponse"/>
  </message>
  <message name="SetAnalysisParamsIn">
    <part name="parameters" element="tns:SetAnalysisParams"/>
  </message>
  <message name="SetAnalysisParamsOut">
    <part name="parameters" element="tns:SetAnalysisParamsResponse"/>
  </message>
  <message name="TriggerReanalysisIn">
    <part name="parameters" element="tns:TriggerReanalysis"/>
  </message>
  <message name="TriggerReanalysisOut">
    <part name="parameters" element="tns:TriggerReanalysisResponse"/>
  </message>
  <message name="TriggerBatchProcessIn">
    <part name="parameters" element="tns:TriggerBatchProcess"/>
  </message>
  <message name="TriggerBatchProcessOut">
    <part name="parameters" element="tns:TriggerBatchProcessResponse"/>
  </message>
  <message name="CloseSessionIn">
    <part name="parameters" element="tns:CloseSession"/>
  </message>
  <message name="CloseSessionOut">
    <part name="parameters" element="tns:CloseSessionResponse"/>
  </message>
  <message name="SaveSessionIn">
    <part name="parameters" element="tns:SaveSession"/>
  </message>
  <message name="SaveSessionOut">
    <part name="parameters" element="tns:SaveSessionResponse"/>
  </message>
  <message name="ListSessionsIn">
    <part name="parameters" element="tns:ListSessions"/>
  </message>
  <message name="ListSessionsOut">
    <part name="parameters" element="tns:ListSessionsResponse"/>
  </message>
  <message name="OpenSessionIn">
    <part name="parameters" element="tns:OpenSession"/>
  </message>
  <message name="OpenSessionOut">
    <part name="parameters" element="tns:OpenSessionResponse"/>
  </message>
  <message name="DeleteSessionIn">
    <part name="parameters" element="tns:DeleteSession"/>
  </message>
  <message name="DeleteSessionOut">
    <part name="parameters" element="tns:DeleteSessionResponse"/>
  </message>
  <message name="ListPanelsIn">
    <part name="parameters" element="tns:ListPanels"/>
  </message>
  <message name="ListPanelsOut">
    <part name="parameters" element="tns:ListPanelsResponse"/>
  </message>
  <message name="ImportPanelIn">
    <part name="parameters" element="tns:ImportPanel"/>
  </message>
  <message name="ImportPanelOut">
    <part name="parameters" element="tns:ImportPanelResponse"/>
  </message>

  <message name="ImportFreqTableIn">
    <part name="parameters" element="tns:ImportFreqTable"/>
  </message>
  <message name="ImportFreqTableOut">
